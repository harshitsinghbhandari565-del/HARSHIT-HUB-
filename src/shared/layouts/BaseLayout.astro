---
/**
 * BaseLayout — TAD §7.3 / Dev Plan T-A6.
 *
 * The standard HTML shell: <html>/<head>, tokens, global styles, the
 * blocking theme FOUC-guard script, and View Transitions routing.
 * Header/Footer/SeoHead composition arrives in Phase C; pages are thin
 * compositions on top of this shell.
 */
// Astro 6 exports ClientRouter from astro:transitions (the /client module
// now carries router utilities only). See DECISIONS.md D-002.
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';

import SkipLink from '../ui/SkipLink.astro';
import { SITE_NAME } from '../config/site';
import '../styles/tokens.css';
import '../styles/tokens.dark.css';
import '../styles/global.css';
import '../styles/utilities.css';

interface Props {
  /** Page title — rendered as "{title} · {SITE_NAME}" (TAD §17.2). */
  title: string;
  /** Meta description; required on indexable pages once content lands. */
  description?: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<!--
  data-theme defaults to light. The FOUC-guard script below sets it to
  "dark" before first paint ONLY when the stored preference says so —
  any failure yields light, the classroom-safe state (TAD §12.2).
-->
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · {SITE_NAME}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!--
      TAD §14.5 — Astro Fonts API injection point. Each <Font /> emits the
      @font-face rules, the optimized family stack (cssVariable), and preload
      hints. Only first-paint weights preload (body 400, hero display 800) —
      remaining weights load on demand without contention.
    -->
    <Font cssVariable="--font-inter-stack" preload={[{ weight: 400, style: 'normal' }]} />
    <Font
      cssVariable="--font-plus-jakarta-sans-stack"
      preload={[{ weight: 800, style: 'normal' }]}
    />
    <script is:inline>
      // FOUC prevention (TAD §12.2): synchronous, inline, <200 bytes.
      // Hash-allowlisted in the CSP once enforcement lands (Phase H).
      try {
        const t = localStorage.getItem('theme');
        if (t === 'dark') document.documentElement.dataset.theme = 'dark';
      } catch {
        // Any failure yields light mode — the classroom-safe default.
      }
    </script>
    <!-- TAD §6.5: View Transitions over real navigations (no client router). -->
    <ClientRouter fallback="swap" />
    <slot name="head" />
  </head>
  <body>
    <!-- First focusable element — WCAG 2.4.1 (Design §25.2). -->
    <SkipLink />
    <slot />
  </body>
</html>

<style is:global>
  /* ── Font token wiring (TAD §14.5) ──
   * tokens.css stays verbatim (Design §26.1). The Astro Fonts API generates
   * optimized family stacks (self-hosted files, latin subset, metric-adjusted
   * fallbacks) as CSS variables; we re-point the design tokens at them here.
   * The inline fallbacks keep rendering correct if the font stack is absent.
   * This block lives in a component style (not global.css) because the Astro
   * compiler collects font usage from component styles only. */
  :root {
    --font-body: var(--font-inter-stack, 'Inter', system-ui, -apple-system, sans-serif);
    --font-display: var(
      --font-plus-jakarta-sans-stack,
      'Plus Jakarta Sans',
      system-ui,
      -apple-system,
      sans-serif
    );
  }
</style>
