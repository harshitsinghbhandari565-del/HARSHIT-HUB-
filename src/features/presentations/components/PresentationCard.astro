---
/**
 * PresentationCard — high-performance list card (Dev Plan T-D2) built on
 * the ADR-0007 linked-card pattern: exactly ONE anchor wrapping the title,
 * whose ::after pseudo-element expands the hit area to the whole card.
 * No nested interactive elements (invalid HTML + broken screen-reader and
 * keyboard semantics — the pattern this ADR replaced).
 *
 * Title clamps to two lines on cards (Design §11.2); detail pages never
 * truncate (Design §15.3).
 *
 * Quick-launch (Design §11.2) is a RECENT-RAIL-ONLY affordance (Design
 * §14.3): a direct Slides anchor revealed on desktop hover / keyboard
 * focus, layered above the hit-area overlay. It is a real anchor — the
 * recency recording on click is a progressive enhancement added by the
 * RecentRail island (Design §29.3), so the launch works with JS disabled.
 */
import { Icon } from 'astro-icon/components';

import PresentationMeta from './PresentationMeta.astro';
import SubjectVisual from './SubjectVisual.astro';
import TagRow from './TagRow.astro';
import type { Subject } from '../../../shared/config/subjects';

interface Props {
  slug: string;
  title: string;
  subject: Subject;
  date: Date;
  tags: string[];
  /** Rail-only direct-launch affordance (Design §11.2). */
  showQuickLaunch?: boolean;
  /** Required with showQuickLaunch: the /present URL to launch. */
  slidesUrl?: string;
}

const { slug, title, subject, date, tags, showQuickLaunch = false, slidesUrl } = Astro.props;
---

<article class="card">
  <SubjectVisual subject={subject} height={120} shape="card" />
  <div class="card__body">
    <PresentationMeta subject={subject} date={date} size="card" />
    <h3 class="card__title">
      <a class="card__link" href={`/presentations/${slug}`}>{title}</a>
    </h3>
    <TagRow tags={tags} overflow />
  </div>
  {
    showQuickLaunch && slidesUrl && (
      <a
        class="card__quick-launch"
        data-quick-launch
        data-slug={slug}
        href={slidesUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`Present “${title}” directly`}
      >
        <Icon name="lucide:play" aria-hidden="true" />
        <span aria-hidden="true">Present</span>
      </a>
    )
  }
</article>

<style>
  .card {
    position: relative; /* anchor for the ::after hit-area overlay */
    display: flex;
    flex-direction: column;
    height: 100%;
    background-color: var(--color-white);
    border: 1px solid var(--color-neutral-200);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-sm);
    transition:
      transform var(--duration-normal) var(--ease-default),
      box-shadow var(--duration-normal) var(--ease-default),
      border-color var(--duration-normal) var(--ease-default);
  }

  .card:hover {
    transform: translateY(-4px);
    border-color: var(--color-primary-200);
    box-shadow: var(--shadow-lg);
  }

  .card__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-4); /* mobile 16px (Design Rule 8) */
  }

  @media (width >= 768px) {
    .card__body {
      padding: var(--space-6); /* desktop 24px */
    }
  }

  .card__title {
    font-family: var(--font-display);
    font-size: var(--text-heading-4);
    font-weight: 600;
    line-height: 1.3;
    color: var(--color-neutral-900);
  }

  .card__link {
    color: inherit;
    text-decoration: none;
  }

  /* ADR-0007 rule 2: the title anchor's ::after expands the hit area to
     the whole card. Because the overlay belongs to the anchor itself, the
     title text stays selectable and every click navigates. */
  .card__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  /* Two-line clamp with ellipsis (Design §11.2). */
  .card__link {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Keyboard focus lands on the anchor — visible ring via the global
     :focus-visible rule (Design §11.2 focus spec). */

  /* ── Quick-launch (rail-only, Design §11.2) ──
     Revealed on desktop hover and keyboard focus-within; sits above the
     hit-area overlay so it stays independently clickable/focusable.
     Touch devices never show it — tap goes to the detail page. */
  .card__quick-launch {
    position: absolute;
    right: var(--space-4);
    bottom: var(--space-4);
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    padding: var(--space-2) var(--space-3);
    color: var(--color-primary-500);
    font-size: var(--text-body-sm);
    font-weight: 600;
    text-decoration: none;
    background-color: var(--color-white);
    border: 1px solid var(--color-neutral-200);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--duration-fast) var(--ease-default);
  }

  @media (hover: hover) and (pointer: fine) {
    .card:hover .card__quick-launch {
      opacity: 1;
      pointer-events: auto;
    }
  }

  .card:focus-within .card__quick-launch {
    opacity: 1;
    pointer-events: auto;
  }
</style>
